Belief Management System
belief_ manager.py
import asyncio
import json
from datetime import datetime
from typing import Dict, List, Any
class BeliefManager:
"""
Mengelola sistem kepercayaan BDI Agent tentang kondisi ekosistem
Mengumpulkan, memproses, dan menganalisis data real-time
"""
def __init__(self):
self.beliefs = {}
self.confidence_threshold = 0.7
self.data_sources = [
'vercel_metrics',
'supabase_health',
'github_actions',
'termux_status',
'agent_performance'
]
async def update_beliefs(self):
"""Update semua beliefs berdasarkan data terkini"""
for source in self.data_sources:
try:
data = await self.collect_data(source)
self.beliefs[source] = {
'data': data,
'timestamp': datetime.now(),
'confidence': self.calculate_confidence(data),
'trend': self.analyze_trend(source, data)
}
except Exception as e:
print(f"Error updating belief {source}: {e}")
async def collect_data(self, source: str) _> Dict:
"""Mengumpulkan data dari berbagai sumber"""
collectors = {
'vercel_metrics': self.get_vercel_metrics,
'supabase_health': self.get_supabase_health,
'github_actions': self.get_github_status,
'termux_status': self.get_termux_status,
'agent_performance': self.get_agent_performance
}
return await collectors[source]()
def get_system_health(self) _> float:
"""Menghitung health score keseluruhan sistem"""
if not self.beliefs:
return 0.0
total_confidence = sum(
belief['confidence'] for belief in self.beliefs.values()
)
return total_confidence / len(self.beliefs)
🎯
Desire Planning Engine
desire_engine.py
class DesireEngine:
"""
Mesin perencanaan tujuan yang adaptif


--- PAGE 2 ---

Menetapkan prioritas dan goals berdasarkan kondisi sistem
"""
def __init__(self, belief_manager):
self.belief_manager = belief_manager
self.goals = []
self.priorities = {
'system_stability': 1.0,
'performance_optimization': 0.8,
'cost_minimization': 0.9,
'security_enhancement': 0.95,
'feature_enhancement': 0.6
}
asyncdef generate_desires(self) _> List[Dict]:
"""Generate desires berdasarkan current beliefs"""
health_score = self.belief_manager.get_system_health()
desires = []
if health_score < 0.7:
desires.append({
'type': 'urgent_fix',
'priority': 1.0,
'description': 'System health degradation detected',
'target_metric': 'health_score',
'target_value': 0.85
})
if self.detect_performance_issues():
desires.append({
'type': 'optimize_performance',
'priority': 0.8,
'description': 'Performance optimization needed',
'target_metric': 'response_time',
'target_value': 200 # ms
})
return sorted(desires, key=lambda x: x['priority'], reverse=True)
