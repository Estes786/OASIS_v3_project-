import asyncio
import subprocess
import json
import os
from pathlib import Path
class TermuxBDIService:
"""Service utama BDI Agent di Termux"""
def __init__(self):
self.config_path = Path.home() / '.bdi_agent'
self.log_path = self.config_path / 'logs'
self.is_running = False
self.setup_environment()
def setup_environment(self):
"""Setup environment Termux untuk BDI Agent"""
self.config_path.mkdir(exist_ok=True)
self.log_path.mkdir(exist_ok=True)
# Install dependencies jika belum ada
required_packages = [
'python', 'nodejs', 'git', 'curl', 'jq'
]
for package in required_packages:
self.ensure_package_installed(package)
async def start_daemon(self):
"""Start BDI Agent daemon"""
self.is_running = True
print("🚀 Starting BDI Agent Service__.")
while self.is_running:
try:
# Jalankan satu siklus BDI
await self.run_bdi_cycle()
# Sleep sebelum cycle berikutnya
await asyncio.sleep(30) # 30 detik interval
except Exception as e:
print(f"❌ Error in BDI cycle: {e}")
await asyncio.sleep(60) # Error recovery delay
async def run_bdi_cycle(self):
"""Menjalankan satu siklus lengkap BDI"""
print("🧠 Running BDI Cycle__.")
# 1. Update Beliefs
beliefs = await self.update_beliefs()
# 2. Generate Desires
desires = await self.generate_desires(beliefs)
# 3. Form Intentions
intentions = await self.form_intentions(desires)
# 4. Execute Actions
await self.execute_actions(intentions)
async def execute_cloud_command(self, command: str) _> str:
"""Execute gcloud atau cloud CLI commands"""
try:
result = subprocess.run(
command,
shell=True,
capture_output=True,
text=True
)
